---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Adrian Bennett',
  description = 'Computer scientist, data engineer, game developer, entrepreneur, and photographer.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/ico" href={`../../public/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav">
      <nav aria-label="Main">
        <a class="nav-logo" href="#top" aria-label="Back to top">
          <span class="nav-logo-mark">✳</span> ab
        </a>
        <ul class="nav-links">
          <li><a href="#about">About</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#games">Games</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p><span class="footer-mark">*</span> Built by Adrian Bennett with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.</p>
    </footer>

    <script>
      // Scroll-reveal: sections and cards fade/slide in once as they enter view.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = Number(el.dataset.revealDelay ?? 0);
                setTimeout(() => el.classList.add('is-revealed'), delay);
                observer.unobserve(el);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }

      // Highlight the nav link for the section currently on screen.
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-links a');
      const sections = [...navLinks]
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((s): s is HTMLElement => s !== null);

      if ('IntersectionObserver' in window && sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              navLinks.forEach((link) =>
                link.classList.toggle('is-active', link.hash === `#${entry.target.id}`)
              );
            }
          },
          { rootMargin: '-40% 0px -55% 0px' }
        );
        sections.forEach((s) => spy.observe(s));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* morning coffee: cream, tans, espresso — with the yellow */
    --cream: #f4ecdd;
    --latte: #ece0c8;
    --card: #efe5d0;
    --line: #d9c8a9;
    --espresso: #32261a;
    --mocha: #7a6749;
    --yellow: #ffd60a;
    --yellow-soft: rgba(255, 214, 10, 0.28);
    --roast: #1f150c; /* darkest — image overlays, lightbox */
    --font-sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas,
      'Liberation Mono', monospace;
    --radius: 18px;
    --ease-pop: cubic-bezier(0.22, 1, 0.36, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  /* the polaroid fly-out animation briefly extends past the viewport edge;
     clip it so it never spawns a horizontal scrollbar */
  html,
  body {
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--espresso);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    /* faint dot grid, like a pour-over filter */
    background-image: radial-gradient(rgba(50, 38, 26, 0.09) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  ::selection {
    background: var(--yellow);
    color: var(--espresso);
  }

  a {
    color: var(--espresso);
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  h1, h2, h3 {
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background: var(--espresso);
    color: var(--cream);
    padding: 0.5rem 1rem;
    border-radius: 0 0 10px 10px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: top 0.2s var(--ease-pop);
  }
  .skip-link:focus {
    top: 0;
  }

  /* ---- Nav ---- */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0.9rem 1rem;
    pointer-events: none;
  }
  .nav nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 0.65rem 0.5rem 1rem;
    background: rgba(244, 236, 221, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 8px 26px rgba(50, 38, 26, 0.14);
  }
  .nav-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--espresso);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-logo-mark {
    color: var(--yellow);
    -webkit-text-stroke: 1px var(--espresso);
    display: inline-block;
    transition: transform 0.5s var(--ease-pop);
  }
  .nav-logo:hover .nav-logo-mark {
    transform: rotate(180deg);
  }
  .nav-links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: var(--mocha);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s, background 0.2s, transform 0.2s var(--ease-pop);
  }
  .nav-links a:hover {
    color: var(--espresso);
    transform: translateY(-1px);
  }
  .nav-links a.is-active {
    background: var(--yellow);
    color: var(--espresso);
    font-weight: 700;
  }

  /* ---- Sections ---- */
  section {
    max-width: 76rem;
    margin: 0 auto;
    padding: 5.5rem 1.5rem 2rem;
    /* clearance for the floating nav on anchor jumps; full-bleed sections override to 0 */
    scroll-margin-top: 1.5rem;
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--mocha);
    margin: 0 0 0.5rem;
  }
  .section-kicker::before {
    content: '// ';
    color: var(--yellow);
    -webkit-text-stroke: 0.5px var(--espresso);
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-bottom: 0.5rem;
  }
  .section-blurb {
    color: var(--mocha);
    max-width: 46rem;
    margin: 0 0 2rem;
  }

  /* yellow highlighter swipe, for a word or two */
  .mark {
    background: linear-gradient(100deg, var(--yellow-soft) 0%, var(--yellow) 4%, var(--yellow-soft) 96%);
    border-radius: 0.3em 0.5em 0.4em 0.3em;
    padding: 0 0.15em;
  }

  /* ---- Reveal motion ---- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s var(--ease-pop);
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  /* ---- Footer ---- */
  .footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 2rem 1.5rem 2.5rem;
    text-align: center;
    color: var(--mocha);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .footer-mark {
    color: var(--yellow);
    -webkit-text-stroke: 1px var(--espresso);
    display: inline-block;
    animation: spin-slow 14s linear infinite;
  }
  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 640px) {
    .nav nav {
      gap: 0.75rem;
    }
    .nav-links a {
      padding: 0.35rem 0.55rem;
      font-size: 0.78rem;
    }
  }
</style>
