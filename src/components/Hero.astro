---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Each role pairs with a polaroid image; the deck shuffles as the title
 * rotates. Swap the placeholder SVGs in src/assets/polaroids/ for real
 * photos of you doing each thing (square-ish crops look best).
 */
const polaroidModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/polaroids/*.{jpg,jpeg,gif,png,webp,svg}',
  { eager: true }
);
const polaroidImages = Object.entries(polaroidModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

const roles = [
  'Computer Scientist',
  'Game Developer',
  'Entrepreneur',
  'Photographer',
];

const deck = roles.map((role, i) => ({
  role,
  image: polaroidImages[i % polaroidImages.length],
}));
---

<section id="top" class="hero" aria-label="Intro">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="hero-hello">// Hey there, I'm</p>
      <h1 class="hero-name">
        Adrian<br />Bennett<span class="hero-dot">.</span>
      </h1>
      <p class="hero-role" data-roles={JSON.stringify(roles)}>
        <span class="hero-role-word">{roles[0]}</span><span class="hero-caret" aria-hidden="true"></span>
      </p>
      <div class="hero-cta">
        <a class="btn btn-solid" href="#projects">My work ↓</a>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="hero-deck" aria-hidden="true">
      {deck.map((card, i) => (
        <figure class="polaroid" data-depth={i}>
          <Image src={card.image} alt="" width={640} height={640} class="polaroid-img" />
          <figcaption class="polaroid-caption">{card.role.toLowerCase()}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <a class="hero-scroll" href="#about" aria-label="Scroll to about section">⌄</a>
</section>

<script>
  const roleEl = document.querySelector<HTMLElement>('.hero-role');
  const wordEl = document.querySelector<HTMLElement>('.hero-role-word');
  const cards = [...document.querySelectorAll<HTMLElement>('.polaroid')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (roleEl && wordEl && cards.length) {
    const roles: string[] = JSON.parse(roleEl.dataset.roles ?? '[]');
    let index = 0;

    setInterval(() => {
      index = (index + 1) % roles.length;

      // title swap
      wordEl.classList.remove('is-swapping');
      void wordEl.offsetWidth;
      wordEl.textContent = roles[index];
      wordEl.classList.add('is-swapping');

      // polaroid shuffle: top card flies out, then tucks under the deck
      const top = cards.find((c) => c.dataset.depth === '0');
      if (!top) return;

      const settle = () => {
        top.classList.remove('is-flying');
        cards.forEach((c) => {
          const d = Number(c.dataset.depth);
          c.dataset.depth = String(d === 0 ? cards.length - 1 : d - 1);
        });
      };

      if (reduceMotion) {
        settle();
      } else {
        top.classList.add('is-flying');
        setTimeout(settle, 420);
      }
    }, 3000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 80svh;
    max-width: 76rem;
    display: flex;
    align-items: flex-end;
    padding: 6rem 1.5rem 5.5rem;
  }

  .hero-inner {
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
  }

  /* ---- name, bottom left ---- */
  .hero-text {
    animation: rise-in 0.8s var(--ease-pop) both;
  }

  .hero-hello {
    font-family: var(--font-mono);
    color: var(--mocha);
    margin: 0 0 1rem;
  }

  .hero-name {
    font-size: clamp(3.2rem, 9vw, 6.8rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .hero-dot {
    color: var(--yellow);
    -webkit-text-stroke: 3px var(--espresso);
  }

  .hero-role {
    margin: 1.2rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    color: var(--espresso);
    min-height: 1.6em;
  }
  .hero-role-word {
    display: inline-block;
    background: var(--yellow);
    border-radius: 0.35em 0.5em 0.4em 0.3em;
    padding: 0.05em 0.3em;
  }
  .hero-role-word.is-swapping {
    animation: word-swap 0.45s var(--ease-pop);
  }
  @keyframes word-swap {
    0% {
      opacity: 0;
      transform: translateY(0.7em) rotate(2deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .hero-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.25em;
    vertical-align: text-bottom;
    background: var(--espresso);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-cta {
    display: flex;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    transition: transform 0.25s var(--ease-pop), box-shadow 0.25s;
  }
  .btn:hover {
    transform: translateY(-3px) rotate(-1deg);
  }
  .btn-solid {
    background: var(--espresso);
    color: var(--cream);
    font-weight: 700;
  }
  .btn-solid:hover {
    box-shadow: 0 8px 24px rgba(50, 38, 26, 0.35);
  }
  .btn-ghost {
    color: var(--espresso);
    border: 1.5px solid var(--espresso);
    background: transparent;
  }
  .btn-ghost:hover {
    background: var(--yellow);
    border-color: var(--espresso);
  }

  /* ---- polaroid deck, bottom right ---- */
  .hero-deck {
    position: relative;
    flex: 0 0 clamp(15rem, 26vw, 21rem);
    aspect-ratio: 5 / 6;
    animation: rise-in 0.8s var(--ease-pop) 0.15s both;
  }

  .polaroid {
    position: absolute;
    inset: 0;
    margin: 0;
    background: #fdfaf2;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4.5% 4.5% 0;
    box-shadow: 0 12px 30px rgba(50, 38, 26, 0.22);
    transition: transform 0.55s var(--ease-pop), z-index 0s;
  }
  /* deck positions by depth */
  .polaroid[data-depth='0'] { z-index: 5; transform: rotate(3deg); }
  .polaroid[data-depth='1'] { z-index: 4; transform: rotate(-4.5deg) translate(-16px, 8px); }
  .polaroid[data-depth='2'] { z-index: 3; transform: rotate(5.5deg) translate(14px, 14px); }
  .polaroid[data-depth='3'] { z-index: 2; transform: rotate(-2deg) translate(-5px, 20px); }
  .polaroid[data-depth='4'] { z-index: 1; transform: rotate(1.5deg) translate(7px, 24px); }
  .polaroid.is-flying {
    z-index: 6;
    transform: translateX(55%) rotate(14deg);
    transition-duration: 0.42s;
  }

  .polaroid :global(img) {
    display: block;
    width: 100%;
    height: 78%;
    object-fit: cover;
    border-radius: 2px;
    background: var(--latte);
  }
  .polaroid-caption {
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.3vw, 0.9rem);
    color: var(--mocha);
    text-align: center;
    padding: 0.55em 0;
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    translate: -50% 0;
    color: var(--mocha);
    font-size: 1.6rem;
    text-decoration: none;
    animation: bob 2s ease-in-out infinite;
  }
  .hero-scroll:hover {
    color: var(--espresso);
  }
  @keyframes bob {
    50% { transform: translateY(6px); }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  @media (max-width: 820px) {
    .hero {
      align-items: center;
    }
    .hero-inner {
      flex-direction: column-reverse;
      align-items: center;
      gap: 2.5rem;
    }
    .hero-text {
      text-align: center;
      width: 100%;
    }
    .hero-cta {
      justify-content: center;
    }
    .hero-deck {
      flex-basis: auto;
      width: min(16rem, 62vw);
    }
  }
</style>
