---
const roles = [
  'Computer Scientist',
  'Data Engineer',
  'Game Developer',
  'Entrepreneur',
  'Photographer',
];
---

<section id="top" class="hero" aria-label="Intro">
  <div class="hero-inner">
    <p class="hero-hello">// hello, world — I'm</p>
    <h1 class="hero-name">
      Adrian<br />Bennett<span class="hero-dot">.</span>
    </h1>
    <p class="hero-role" data-roles={JSON.stringify(roles)}>
      <span class="hero-role-word">{roles[0]}</span><span class="hero-caret" aria-hidden="true"></span>
    </p>
    <div class="hero-cta">
      <a class="btn btn-solid" href="#projects">See my work ↓</a>
      <a class="btn btn-ghost" href="#contact">Say hello</a>
    </div>
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
  <a class="hero-scroll" href="#about" aria-label="Scroll to about section">⌄</a>
</section>

<script>
  const roleEl = document.querySelector<HTMLElement>('.hero-role');
  const wordEl = document.querySelector<HTMLElement>('.hero-role-word');

  if (roleEl && wordEl) {
    const roles: string[] = JSON.parse(roleEl.dataset.roles ?? '[]');
    let index = 0;

    setInterval(() => {
      index = (index + 1) % roles.length;
      wordEl.classList.remove('is-swapping');
      // restart the CSS animation
      void wordEl.offsetWidth;
      wordEl.textContent = roles[index];
      wordEl.classList.add('is-swapping');
    }, 2800);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    max-width: none;
    display: grid;
    place-items: center;
    padding: 6rem 1.5rem 4rem;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-hello {
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin: 0 0 1rem;
    animation: rise-in 0.7s var(--ease-pop) both;
  }

  .hero-name {
    font-size: clamp(3.2rem, 11vw, 7.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    animation: rise-in 0.7s var(--ease-pop) 0.1s both;
  }
  .hero-dot {
    color: var(--yellow);
  }

  .hero-role {
    margin: 1.4rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 2.6vw, 1.5rem);
    color: var(--yellow);
    min-height: 1.6em;
    animation: rise-in 0.7s var(--ease-pop) 0.2s both;
  }
  .hero-role-word {
    display: inline-block;
  }
  .hero-role-word.is-swapping {
    animation: word-swap 0.45s var(--ease-pop);
  }
  @keyframes word-swap {
    0% {
      opacity: 0;
      transform: translateY(0.7em) rotate(2deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .hero-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.18em;
    vertical-align: text-bottom;
    background: var(--yellow);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-cta {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2.4rem;
    animation: rise-in 0.7s var(--ease-pop) 0.3s both;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    transition: transform 0.25s var(--ease-pop), box-shadow 0.25s, background 0.25s;
  }
  .btn:hover {
    transform: translateY(-3px) rotate(-1deg);
  }
  .btn-solid {
    background: var(--yellow);
    color: #111;
    font-weight: 700;
  }
  .btn-solid:hover {
    box-shadow: 0 8px 24px rgba(255, 214, 10, 0.35);
  }
  .btn-ghost {
    color: var(--text);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .btn-ghost:hover {
    border-color: var(--yellow);
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38rem 24rem at 50% 18%, rgba(255, 214, 10, 0.09), transparent 70%),
      radial-gradient(30rem 20rem at 18% 85%, rgba(255, 214, 10, 0.05), transparent 70%);
    animation: glow-drift 12s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes glow-drift {
    to { transform: translate3d(0, -2.5rem, 0) scale(1.06); }
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    translate: -50% 0;
    color: var(--text-muted);
    font-size: 1.6rem;
    text-decoration: none;
    animation: bob 2s ease-in-out infinite;
  }
  .hero-scroll:hover {
    color: var(--yellow);
  }
  @keyframes bob {
    50% { transform: translateY(6px); }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }
</style>
