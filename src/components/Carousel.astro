---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  id: string;
  kicker: string;
  title: string;
  blurb: string;
  items: Project[];
}

const { id, kicker, title, blurb, items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

/**
 * `video` entries are paths inside public/ ('work/modem.webm'), so they need
 * the site `base` prepended — this site is served from a subpath.
 */
const MIME: Record<string, string> = {
  webm: 'video/webm',
  mp4: 'video/mp4',
  ogv: 'video/ogg',
  mov: 'video/quicktime',
};

const base = import.meta.env.BASE_URL;

const sourcesFor = (video: Project['video']) =>
  (Array.isArray(video) ? video : video ? [video] : []).map((path) => ({
    src: /^(https?:)?\/\//.test(path)
      ? path
      : `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`,
    type: MIME[path.split('.').pop()?.toLowerCase() ?? ''],
  }));
---

<section id={id} class="showcase-section">
  <div class="showcase" data-reveal>
    <ul class="showcase-track" tabindex="0" aria-label={`${title} slides`}>
      {items.map((item) => {
        const sources = sourcesFor(item.video);
        return (
        <li class="slide">
          {/* The poster always renders: it is the LCP image, the buffering
              placeholder, and the whole story under `prefers-reduced-motion`.
              Any video fades in over the top of it once it is actually playing. */}
          <Image src={item.image} alt={item.title} class="slide-media slide-img" width={1920} />
          {sources.length > 0 && (
            <video
              class="slide-media slide-video"
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              aria-hidden="true"
              tabindex="-1"
            >
              {/* `data-src` until the slide is in view — nothing downloads before then */}
              {sources.map((source) => (
                <source data-src={source.src} type={source.type} />
              ))}
            </video>
          )}
          <div class="slide-scrim" aria-hidden="true"></div>
          <div class="slide-info">
            <h3 class="slide-title">{item.title}</h3>
            <p class="slide-sub">
              <span class="slide-subtitle">{item.subtitle}</span>
              {item.tags.map((tag) => (
                <span class="slide-tag">{tag}</span>
              ))}
            </p>
            {/* set:html so a description can carry inline markup — mainly <a>,
                for crediting a collaborator. The strings are authored in
                projects.ts, never user input, so there is nothing to sanitize. */}
            <p class="slide-desc" set:html={item.description}></p>
            {item.links && item.links.length > 0 && (
              <p class="slide-links">
                {item.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">
                    {link.label} ↗
                  </a>
                ))}
              </p>
            )}
          </div>
        </li>
        );
      })}
    </ul>

    <header class="showcase-header">
      <p class="showcase-kicker">{kicker}</p>
      <h2 class="showcase-title">{title}</h2>
      <p class="showcase-blurb">{blurb}</p>
    </header>

    <div class="showcase-ui">
      <span class="showcase-count" aria-live="polite">
        <span class="showcase-current">01</span>&nbsp;/&nbsp;{pad(items.length)}
      </span>
      <button class="showcase-btn" data-dir="-1" aria-label="Previous slide">←</button>
      <button class="showcase-btn" data-dir="1" aria-label="Next slide">→</button>
    </div>
  </div>
</section>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.showcase').forEach((showcase) => {
    const track = showcase.querySelector<HTMLElement>('.showcase-track');
    const current = showcase.querySelector<HTMLElement>('.showcase-current');
    if (!track) return;
    const count = track.children.length;

    const indexNow = () =>
      Math.round(track.scrollLeft / track.clientWidth);

    showcase.querySelectorAll<HTMLButtonElement>('.showcase-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        // wrap around at the ends
        const next = (indexNow() + Number(btn.dataset.dir) + count) % count;
        track.scrollTo({ left: next * track.clientWidth, behavior: 'smooth' });
      });
    });

    track.addEventListener(
      'scroll',
      () => {
        if (current) current.textContent = String(indexNow() + 1).padStart(2, '0');
      },
      { passive: true }
    );

    /* ---- slide videos ----
       A video only earns its bytes while its slide is the one being looked at,
       so playback is gated on two things at once: the slide is the one snapped
       into the track, and the carousel itself is somewhere on screen. Sources
       stay in `data-src` until that first becomes true, so a visitor who never
       reaches this section downloads no video at all. */
    const slides = Array.from(track.children) as HTMLElement[];
    const videos = slides.map((slide) =>
      slide.querySelector<HTMLVideoElement>('video.slide-video')
    );
    if (!videos.some(Boolean)) return;

    const onScreen = new Set<number>();
    let sectionVisible = false;
    let pageVisible = !document.hidden;

    const attachSources = (video: HTMLVideoElement) => {
      if (video.dataset.loaded) return;
      video.dataset.loaded = 'true';
      // Autoplay is only permitted for muted video, and the attribute alone is
      // not always enough once sources are swapped in — set the property too.
      video.muted = true;
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        source.src = source.dataset.src!;
        source.removeAttribute('data-src');
      });
      video.load();
    };

    const sync = () => {
      videos.forEach((video, i) => {
        if (!video) return;
        const shouldPlay =
          sectionVisible && pageVisible && onScreen.has(i) && !reduceMotion.matches;
        if (shouldPlay) {
          attachSources(video);
          // Autoplay can still be refused (low power mode, data saver);
          // the poster underneath stays put, so there is nothing to handle.
          void video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      });
    };

    // `playing` rather than `canplay`: only fade the video in once real frames
    // are on screen, otherwise the poster blinks out to a blank first frame.
    videos.forEach((video) => {
      video?.addEventListener('playing', () => video.classList.add('is-ready'), {
        once: true,
      });
    });

    // Which slide is snapped into the track.
    const slideObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const i = slides.indexOf(entry.target as HTMLElement);
          if (entry.isIntersecting) onScreen.add(i);
          else onScreen.delete(i);
        });
        sync();
      },
      { root: track, threshold: 0.5 }
    );
    slides.forEach((slide) => slideObserver.observe(slide));

    // Whether the carousel is on screen at all (vertical page scroll).
    const sectionObserver = new IntersectionObserver(
      ([entry]) => {
        sectionVisible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.05 }
    );
    sectionObserver.observe(showcase);

    reduceMotion.addEventListener('change', sync);
    // A backgrounded tab throttles timers but keeps decoding video.
    document.addEventListener('visibilitychange', () => {
      pageVisible = !document.hidden;
      sync();
    });
  });
</script>

<style>
  /* full-bleed: escape the global section container */
  .showcase-section {
    max-width: none;
    padding: 0;
    margin: 3.5rem 0 0;
    scroll-margin-top: 0;
  }

  /* consecutive showcases: bunch together for unity */
  .showcase-section ~ .showcase-section {
    margin-top: 0;
    padding-top: 0rem;
    background: var(--roast);
  }

  .showcase {
    position: relative;
  }

  .showcase-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .showcase-track::-webkit-scrollbar {
    display: none;
  }
  .showcase-track:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: -3px;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    height: 100svh;
    overflow: hidden;
  }

  /* poster image and video occupy the same box, video stacked on top */
  .slide :global(.slide-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  /* set once the video is genuinely playing, so the poster never blinks */
  .slide-video.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-video {
      display: none;
    }
  }

  /* gradients top and bottom so the header and info read over any image */
  .slide-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(31, 21, 12, 0.78) 0%,
        rgba(31, 21, 12, 0.35) 18%,
        rgba(31, 21, 12, 0) 38%
      ),
      linear-gradient(
        to top,
        rgba(31, 21, 12, 0.94) 0%,
        rgba(31, 21, 12, 0.55) 26%,
        rgba(31, 21, 12, 0) 55%
      );
  }

  /* ---- section header, overlaid top left ---- */
  .showcase-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 5.5rem clamp(1.3rem, 4vw, 3rem) 0;
    color: var(--cream);
    pointer-events: none;
  }
  .showcase-kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(253, 250, 242, 0.75);
    margin: 0 0 0.4rem;
  }
  .showcase-kicker::before {
    content: '// ';
    color: var(--yellow);
  }
  .showcase-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: #fdfaf2;
  }
  .showcase-blurb {
    color: rgba(253, 250, 242, 0.75);
    max-width: 40rem;
    margin: 0.5rem 0 0;
    font-size: 0.98rem;
  }

  /* ---- per-slide info, bottom left ---- */
  .slide-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.8rem clamp(1.3rem, 4vw, 3rem) 2.2rem;
    /* leave room for the arrows */
    padding-right: clamp(9rem, 16vw, 13rem);
    color: var(--cream);
  }
  .slide-title {
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    color: #fdfaf2;
  }
  .slide-sub {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.55rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
  .slide-subtitle {
    color: var(--yellow);
  }
  .slide-tag {
    border: 1px solid rgba(253, 250, 242, 0.4);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    color: rgba(253, 250, 242, 0.85);
  }
  .slide-desc {
    margin: 0.65rem 0 0;
    max-width: 36rem;
    font-size: 0.98rem;
    color: rgba(253, 250, 242, 0.82);
  }
  /* inline links inside a description — brighter than the body copy around
     them, and underlined in yellow to match .slide-links below */
  .slide-desc :global(a) {
    color: #fdfaf2;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-underline-offset: 0.15em;
    transition: color 0.2s;
  }
  .slide-desc :global(a:hover) {
    color: var(--yellow);
  }
  .slide-links {
    margin: 0.75rem 0 0;
    display: flex;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  .slide-links a {
    color: #fdfaf2;
    text-decoration-color: var(--yellow);
    transition: color 0.2s;
  }
  .slide-links a:hover {
    color: var(--yellow);
  }

  /* ---- bare-bones UI: counter + arrows, bottom right ---- */
  .showcase-ui {
    position: absolute;
    right: clamp(1.3rem, 4vw, 3rem);
    bottom: 2.2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .showcase-count {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: rgba(253, 250, 242, 0.85);
    margin-right: 0.3rem;
  }
  .showcase-btn {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--espresso);
    background: rgba(253, 250, 242, 0.92);
    border: none;
    border-radius: 999px;
    width: 2.7rem;
    height: 2.7rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease-pop);
  }
  .showcase-btn:hover {
    background: var(--yellow);
    transform: translateY(-2px);
  }
  .showcase-btn:active {
    transform: translateY(0) scale(0.95);
  }

  @media (max-width: 640px) {
    .showcase-header {
      padding-top: 4.6rem;
    }
    .showcase-blurb {
      display: none;
    }
    .slide-info {
      padding-bottom: 5.2rem;
      padding-right: clamp(1.3rem, 4vw, 3rem);
    }
    .showcase-ui {
      bottom: 1.2rem;
    }
  }
</style>
