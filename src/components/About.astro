---
const education = [
  {
    degree: 'B.S. Computer Science',
    school: 'Auburn University',
    when: 'Graduating 2027',
    emoji: '🎓',
  },
  {
    degree: 'Minor in International Business Engineering & Technology',
    school: 'Auburn University',
    when: 'Awarded 2026',
    emoji: '🌍'
  },
  {
    degree: 'M.S. Data Engineering',
    school: 'Auburn University',
    when: 'Graduating 2028',
    emoji: '📈',
  },
];

const roles = [
  { emoji: '🕹️', label: 'Game Developer' },
  { emoji: '🎨', label: '3D Artist'},
  { emoji: '🛠️', label: 'Mechanic'},
  { emoji: '🧪', label: 'Homelabber'},
  { emoji: '🚀', label: 'Entrepreneur' },
  { emoji: '📷', label: 'Photographer' },
  { emoji: '✏️', label: 'UX Designer'},
  { emoji: '🎥', label: 'Video Editor'},
  { emoji: '🌐', label: 'Web Developer'},
];
---

<section id="about">
  <div data-reveal>
    <p class="section-kicker">about</p>
    <h2 class="section-title">"Often times better<br />than a master of <span class="mark">one</span>."</h2>
    <p class="section-blurb">
      I'm Adrian and I strive to make a positive impact wherever I work. I believe the best
      learning begins in the field, not just in the classroom. That's why I'm always pushing myself outside of my
      comfort zone, taking on unique projects and challenges that give me the opportunity to learn something new.
      <br><br>
      Building a diverse skill set allows me to adapt, take on new roles, and approach problems from an array of
      perspectives. <b>I know experience is built by doing, and there's always another skill to learn, challenge to tackle,
      or idea to explore.</b>
    </p>
  </div>

  <div class="about-grid">
    <div class="edu" data-reveal>
      <h3 class="about-subhead">Education</h3>
      <ol class="edu-list">
        {education.map((e, i) => (
          <li class="edu-item" data-reveal data-reveal-delay={i * 90}>
            <span class="edu-emoji" aria-hidden="true">{e.emoji}</span>
            <div>
              <p class="edu-degree">{e.degree}</p>
              <p class="edu-school">{e.school}</p>
            </div>
            <span class="edu-when">{e.when}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="roles" data-reveal>
      <h3 class="about-subhead">Meanwhile, also</h3>
      <ul class="role-list">
        {roles.map((r, i) => (
          <li class="role-chip" data-reveal data-reveal-delay={i * 60}>
            <span aria-hidden="true">{r.emoji}</span> {r.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about-subhead {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--mocha);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .edu-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    transition: transform 0.3s var(--ease-pop), border-color 0.3s,
      opacity 0.6s ease;
  }
  .edu-item:hover {
    transform: translateY(-3px) rotate(-0.4deg);
    border-color: var(--espresso);
  }
  .edu-emoji {
    font-size: 1.6rem;
  }
  .edu-degree {
    font-weight: 700;
    margin: 0;
  }
  .edu-school {
    margin: 0;
    color: var(--mocha);
    font-size: 0.92rem;
  }
  .edu-when {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--espresso);
    background: var(--yellow);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    white-space: nowrap;
  }

  .role-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .role-chip {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    background: transparent;
    border: 1.5px solid var(--espresso);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    transition: transform 0.25s var(--ease-pop), background 0.25s,
      opacity 0.6s ease;
  }
  .role-chip:hover {
    background: var(--yellow);
    transform: translateY(-3px) rotate(-1deg);
  }
  .role-chip:nth-child(even):hover {
    transform: translateY(-3px) rotate(1deg);
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .edu-item {
      flex-wrap: wrap;
      gap: 0.8rem;
    }
  }
</style>
