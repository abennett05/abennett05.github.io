---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Every image dropped into src/assets/photos/ shows up here automatically —
 * add or delete files in that folder to manage the gallery.
 */
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif,gif,svg}',
  { eager: true }
);
const photos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

// Two counter-scrolling rows.
const rowA = photos.filter((_, i) => i % 2 === 0);
const rowB = photos.filter((_, i) => i % 2 === 1);

const contacts = [
  { label: 'Email', url: 'mailto:adrian@quicomm.com', icon: '✉️' },
  { label: 'GitHub', url: 'https://github.com/abennett05', icon: '🐙' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/adrian-bennett-76147332a/', icon: '💼' },
  { label: 'Dead Tag Studios', url: 'https://deadtag.studio/games', icon: '🎮' },
];
---

<section id="contact">
  <div data-reveal>
    <p class="section-kicker">contact / gallery</p>
    <h2 class="section-title">Say hello. Stay for the photos.</h2>
    <p class="section-blurb">
      The best way to reach me is by email. While you're here, feel free to check out more of my projects on Github, 
      connect with me on LinkedIn, 
      or even take a gander at the games I make over at Dead Tag Studios. Don't forget about my photos below!
    </p>
    <div class="contact-links">
      {contacts.map((c) => (
        <a href={c.url} target={c.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
          <span aria-hidden="true">{c.icon}</span> {c.label}
        </a>
      ))}
    </div>
  </div>
</section>

<div class="gallery" data-reveal>
  {[
    { row: rowA, reverse: false },
    { row: rowB, reverse: true },
  ].map(({ row, reverse }) => (
    <div class="marquee" data-reverse={reverse ? '' : undefined}>
      <div class="marquee-track">
        {/* 4 copies so even a short row fills the loop without gaps */}
        {[0, 1, 2, 3].map((copy) => {
          const isClone = copy > 0;
          return (
          <div class="marquee-group" aria-hidden={isClone ? 'true' : undefined}>
            {row.map((photo) => (
              <button
                class="shot"
                type="button"
                tabindex={isClone ? -1 : 0}
                aria-label="View photo full screen"
              >
                <Image src={photo} alt="" height={480} />
              </button>
            ))}
          </div>
          );
        })}
      </div>
    </div>
  ))}
</div>

<div class="lightbox" hidden>
  <div class="lightbox-backdrop"></div>
  <img class="lightbox-img" alt="Full screen photo" />
  <button class="lightbox-close" type="button" aria-label="Close full screen photo">✕</button>
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>('.lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox-img');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let sourceImg: HTMLImageElement | null = null;
  let lastFocus: HTMLElement | null = null;

  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const DURATION = 420;

  function targetRect(img: HTMLImageElement) {
    const iw = img.naturalWidth || img.width || 4;
    const ih = img.naturalHeight || img.height || 3;
    const scale = Math.min((innerWidth * 0.92) / iw, (innerHeight * 0.88) / ih);
    const w = iw * scale;
    const h = ih * scale;
    return { left: (innerWidth - w) / 2, top: (innerHeight - h) / 2, width: w, height: h };
  }

  function transformBetween(from: DOMRect | ReturnType<typeof targetRect>, to: ReturnType<typeof targetRect>) {
    return `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`;
  }

  function open(img: HTMLImageElement, trigger: HTMLElement) {
    if (!lightbox || !lightboxImg) return;
    sourceImg = img;
    lastFocus = trigger;
    lightboxImg.src = img.currentSrc || img.src;

    lightbox.hidden = false;
    document.body.classList.add('lightbox-open');

    const to = targetRect(img);
    Object.assign(lightboxImg.style, {
      left: `${to.left}px`,
      top: `${to.top}px`,
      width: `${to.width}px`,
      height: `${to.height}px`,
    });

    if (!reduceMotion) {
      lightboxImg.animate(
        [
          { transform: transformBetween(img.getBoundingClientRect(), to), borderRadius: '12px' },
          { transform: 'none', borderRadius: '4px' },
        ],
        { duration: DURATION, easing: EASE }
      );
    }
    closeBtn?.focus();
  }

  function close() {
    if (!lightbox || !lightboxImg) return;

    const finish = () => {
      lightbox.hidden = true;
      document.body.classList.remove('lightbox-open');
      lastFocus?.focus();
      sourceImg = null;
    };

    if (reduceMotion || !sourceImg || !sourceImg.isConnected) {
      finish();
      return;
    }

    const to = targetRect(sourceImg);
    const anim = lightboxImg.animate(
      [
        { transform: 'none', borderRadius: '4px' },
        { transform: transformBetween(sourceImg.getBoundingClientRect(), to), borderRadius: '12px' },
      ],
      { duration: DURATION * 0.85, easing: EASE }
    );
    lightbox.classList.add('is-closing');
    anim.onfinish = () => {
      lightbox.classList.remove('is-closing');
      finish();
    };
  }

  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img');
      if (img) open(img, btn);
    });
  });

  lightbox?.addEventListener('click', close);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) close();
  });
</script>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .contact-links a {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--espresso);
    text-decoration: none;
    background: transparent;
    border: 1.5px solid var(--espresso);
    border-radius: 999px;
    padding: 0.6rem 1.2rem;
    transition: background 0.2s, transform 0.25s var(--ease-pop);
  }
  .contact-links a:hover {
    background: var(--yellow);
    transform: translateY(-3px) rotate(-1deg);
  }

  /* ---- Marquee ---- */
  .gallery {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    overflow: hidden;
  }

  .marquee {
    overflow: hidden;
    /* soft fade at the edges */
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 55s linear infinite;
  }
  .marquee[data-reverse] .marquee-track {
    animation-direction: reverse;
  }
  .marquee:hover .marquee-track,
  :global(body.lightbox-open) .marquee-track {
    animation-play-state: paused;
  }
  /* 4 identical groups, so shifting by 25% loops seamlessly */
  @keyframes marquee {
    to {
      transform: translateX(-25%);
    }
  }

  .marquee-group {
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }

  .shot {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    cursor: zoom-in;
    overflow: hidden;
    box-shadow: 0 8px 20px rgba(50, 38, 26, 0.12);
    transition: transform 0.3s var(--ease-pop), border-color 0.3s;
  }
  .shot:hover,
  .shot:focus-visible {
    transform: translateY(-4px) rotate(-0.6deg);
    border-color: var(--espresso);
  }
  /* the <Image> component's img doesn't carry this file's scope attribute */
  .shot :global(img) {
    display: block;
    height: clamp(9rem, 22vw, 14rem);
    width: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      overflow-x: auto;
    }
    .marquee {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  /* ---- Lightbox ---- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
  }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(31, 21, 12, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fade-in 0.35s ease both;
  }
  .lightbox.is-closing .lightbox-backdrop {
    animation: fade-in 0.3s ease reverse both;
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }

  .lightbox-img {
    position: absolute;
    border-radius: 4px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
    cursor: zoom-out;
    transform-origin: top left;
  }

  .lightbox-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    width: 2.8rem;
    height: 2.8rem;
    font-size: 1.1rem;
    color: var(--espresso);
    background: rgba(253, 250, 242, 0.92);
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease-pop);
    animation: fade-in 0.35s ease both;
  }
  .lightbox-close:hover {
    background: var(--yellow);
    transform: rotate(90deg);
  }
</style>
